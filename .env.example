# Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Security ----
SECRET_KEY=change-me-to-a-random-secret-in-production

# ---- Server Ports (Managed by Launcher) ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT_START=9100
BACKEND_PORT_END=9120

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT_START=9121
FRONTEND_PORT_END=9140

OPEN_BROWSER=true

# ---- Network & Discovery ----
MONITOR_HOST=10.119.43.25
DISCOVERY_NETWORKS=10.119.34.0/24,10.119.43.0/24
DISCOVERY_CONCURRENCY=20

# ---- SNMP ----
SNMP_PORT=161
SNMP_TIMEOUT=3
SNMP_RETRIES=1

OFFLINE_FAILURE_THRESHOLD=3

# ---- Monitoring Intervals (Seconds) ----
STATUS_INTERVAL=30
SUPPLIES_INTERVAL=300
COUNTERS_INTERVAL=600

# ---- LINE Notify ----
LINE_NOTIFY_TOKEN=

# ---- Microsoft Teams ----
TEAMS_WEBHOOK_URL=

# ---- SMTP Email ----
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@yourdomain.com
SMTP_TO_EMAIL=admin@yourdomain.com
