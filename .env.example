# Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Security ----
SECRET_KEY=change-me-to-a-random-secret-in-production

# ---- LINE Notify ----
LINE_NOTIFY_TOKEN=

# ---- Microsoft Teams ----
TEAMS_WEBHOOK_URL=

# ---- SMTP Email ----
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@yourdomain.com
SMTP_TO_EMAIL=admin@yourdomain.com
